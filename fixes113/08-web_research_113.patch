+    def entry(self, url: str) -> dict[str, Any] | None:
+        """(#113) The raw entry, ignoring the TTL; None when absent or damaged.
+
+        A stale-but-intact entry is exactly what a conditional GET needs:
+        its validators, and its body as the fallback if the origin answers
+        304. The digest check still runs -- a truncated body is never sent
+        anywhere, fresh or stale.
+        """
+        with self._lock:
+            entry = self._load().get(url)
+        if not isinstance(entry, dict) or not isinstance(entry.get("text"), str):
+            return None
+        digest = entry.get("hash")
+        if (
+            not isinstance(digest, str)
+            or hashlib.sha256(entry["text"].encode()).hexdigest() != digest
+        ):
+            return None
+        if not isinstance(entry.get("fetched_at"), (int, float)):
+            return None
+        return entry
